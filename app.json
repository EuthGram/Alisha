{
  "name": "Sonali Chat",
  "description": "Sonali Chat is an AI-powered Telegram bot with smart responses, automation, and seamless integrations using Python, MongoDB, and Pyrogram.",
  "logo": "https://graph.org/file/826485f2d7db6f09db8ed.jpg",
  "keywords": [
    "SonaliChat",
    "MongoDB",
    "Python",
    "Pyrogram"
  ],
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "repository": "https://github.com/TEAMPURVI/PURVI_CHAT",
  "env": {
    "API_ID": {
      "description": "Get this value from my.telegram.org/apps.",
      "required": true,
      "value": "39792511"
    },
    "API_HASH": {
      "description": "Get this value from my.telegram.org/apps.",
      "required": true,
      "value": "45c445ee134ca8645e7f34ba795849df"
    },
    "BOT_TOKEN": {
      "description": "A bot token from @BotFather.",
      "required": true,
      "value": ""
    },
    "MONGO_URL": {
      "description": "MongoDB connection URL from https://cloud.mongodb.com.",
      "required": true,
      "value": "mongodb+srv://euthledemo:euthle.pass@cluster0.k5jdjvi.mongodb.net/?appName=Cluster0"
    },
    "AUTH_CHANNEL": {
      "description": "The Telegram channel ID for Fsub authentication.",
      "required": true,
      "value": "-1003897378101"
    },
    "FSUB": {
      "description": "Enable forced subscription (true/false) & Promote Bot Admin On Fsub Channel",
      "required": true,
      "value": "True"
    },
    "OWNER_ID": {
      "description": "User ID of the bot owner.",
      "required": true,
      "value": "8212067566"
    }
  }
}
